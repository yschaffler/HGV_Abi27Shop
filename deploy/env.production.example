# ---------------------------------------------------------------------------
# Abi-Shop – Konfiguration für den Produktionsbetrieb
#
# Auf dem Server nach /opt/abi-shop/.env kopieren und ausfüllen:
#
#   install -m 600 deploy/env.production.example /opt/abi-shop/.env
#
# Rechte 600: Die Datei enthält Datenbankpasswort, Stripe-Schlüssel und AUTH_SECRET.
# Sie gehört NIEMALS ins Repository.
# ---------------------------------------------------------------------------

# --- Images ----------------------------------------------------------------
# Werden vom GitHub-Workflow gebaut und veröffentlicht.
IMAGE_APP="ghcr.io/yschaffler/abi-shop"
IMAGE_MIGRATOR="ghcr.io/yschaffler/abi-shop-migrator"

# "latest" folgt automatisch dem Hauptzweig. Für ein Rollback hier einen festen Tag
# eintragen, etwa sha-a1b2c3d, und danach deploy/update.sh von Hand ausführen.
IMAGE_TAG="latest"

# --- Datenbank -------------------------------------------------------------
MYSQL_DATABASE="abishop"
MYSQL_USER="abishop"
# Erzeugen mit: openssl rand -base64 30
MYSQL_PASSWORD=""
MYSQL_ROOT_PASSWORD=""

# --- Anwendung -------------------------------------------------------------
APP_URL="https://abi.yschaffler.de"

# Mindestens 32 Zeichen. Erzeugen mit: openssl rand -base64 48
# Wird dieser Wert geändert, sind alle Sessions ungültig UND die gespeicherten
# 2FA-Secrets nicht mehr entschlüsselbar – Admins müssten den zweiten Faktor neu
# einrichten. Also einmal setzen und sicher aufbewahren.
AUTH_SECRET=""

SESSION_MAX_AGE_HOURS="12"

# Port, auf dem der Container an 127.0.0.1 lauscht. nginx leitet dorthin weiter.
APP_PORT="3000"

# --- Stripe ----------------------------------------------------------------
# Live-Schlüssel beginnt mit sk_live_
STRIPE_SECRET_KEY=""

# Signing Secret des Webhook-Endpunkts für https://abi.yschaffler.de/api/stripe/webhook
# ACHTUNG: Test- und Live-Modus haben unterschiedliche Secrets.
STRIPE_WEBHOOK_SECRET=""

# Leer lassen – dann bietet Stripe genau die im Dashboard freigeschalteten Zahlarten an,
# inklusive PayPal, sofern für das Konto verfügbar.
STRIPE_PAYMENT_METHOD_TYPES=""

# --- E-Mail ----------------------------------------------------------------
# "console" ist in Produktion nicht zulässig – die Anwendung startet damit nicht.
EMAIL_DRIVER="smtp"
EMAIL_FROM="Abi-Shop <abi@yschaffler.de>"
EMAIL_REPLY_TO=""

# Nur bei EMAIL_DRIVER=resend
RESEND_API_KEY=""

# Nur bei EMAIL_DRIVER=smtp
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
