# ---------------------------------------------------------------------------
# Abi-Shop – Konfiguration
#
# Diese Datei nach .env kopieren und ausfuellen. .env ist in .gitignore und gehoert
# NIEMALS ins Repository. Alle Werte werden beim ersten Zugriff mit Zod geprueft;
# fehlt etwas, sagt die Anwendung beim Start welcher Wert und warum.
# ---------------------------------------------------------------------------

# --- Datenbank -------------------------------------------------------------
# Bei docker compose wird DATABASE_URL automatisch aus MYSQL_* zusammengesetzt;
# dann reichen die drei Werte darunter.
DATABASE_URL="mysql://abishop:BITTE_AENDERN@127.0.0.1:3306/abishop"

MYSQL_DATABASE="abishop"
MYSQL_USER="abishop"
MYSQL_PASSWORD="BITTE_AENDERN"
MYSQL_ROOT_PASSWORD="BITTE_AUCH_AENDERN"

# Pool- und TLS-Einstellungen werden als Query-Parameter an DATABASE_URL angehaengt, z. B.:
#   mysql://user:pass@host:3306/db?connectionLimit=10&connectTimeout=10000&ssl={"rejectUnauthorized":true}

# --- Anwendung -------------------------------------------------------------
# Oeffentliche Adresse ohne abschliessenden Slash. In Produktion zwingend https://
APP_URL="http://localhost:3000"

# Basis fuer Session-Cookies und die Verschluesselung der 2FA-Secrets.
# Mindestens 32 Zeichen. Erzeugen mit:  openssl rand -base64 48
AUTH_SECRET=""

# Laufzeit einer Admin-Session in Stunden.
SESSION_MAX_AGE_HOURS="12"

# Nur auf true setzen, wenn die App wirklich hinter einem Reverse Proxy laeuft, dem man
# vertraut. Sonst koennte jeder sein Rate Limit per X-Forwarded-For umgehen.
TRUST_PROXY_HEADERS="false"

# Ablage der Produktbilder. Im Container ein persistentes Volume.
UPLOAD_DIR="./data/uploads"

# Port, auf dem docker compose den Shop an localhost bindet.
APP_PORT="3000"

# --- Stripe ----------------------------------------------------------------
# Test- und Live-Schluessel nicht verwechseln: sk_test_... bzw. sk_live_...
STRIPE_SECRET_KEY=""

# Aus dem Stripe-Dashboard, Abschnitt Webhooks. Fuer Test und Live unterschiedlich!
STRIPE_WEBHOOK_SECRET=""

# Leer lassen ist der empfohlene Weg: Stripe bietet dann genau die Zahlarten an, die im
# Dashboard fuer dieses Konto und Land freigeschaltet sind – inklusive PayPal, sofern
# verfuegbar. Nur zum Erzwingen setzen, z. B.: "card,paypal"
STRIPE_PAYMENT_METHOD_TYPES=""

# --- E-Mail ----------------------------------------------------------------
# console = schreibt die Mail nur ins Log (nur Entwicklung, in Produktion abgelehnt)
# resend  = HTTP-API von Resend
# smtp    = klassischer Mailserver, z. B. der der Schule
EMAIL_DRIVER="console"

# Absender. Die Domain muss beim Versanddienst verifiziert sein, sonst landet alles im Spam.
EMAIL_FROM="Abi-Shop <abi@example.de>"
EMAIL_REPLY_TO=""

# Nur bei EMAIL_DRIVER=resend
RESEND_API_KEY=""

# Nur bei EMAIL_DRIVER=smtp
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# false = STARTTLS auf Port 587 (Standard), true = implizites TLS auf Port 465
SMTP_SECURE="false"

# --- Tests -----------------------------------------------------------------
# Eigene Datenbank fuer die Integrationstests. Der Name MUSS "test" enthalten –
# die Tests leeren diese Datenbank bei jedem Testfall.
TEST_DATABASE_URL="mysql://abishop:BITTE_AENDERN@127.0.0.1:3306/abishop_test"
